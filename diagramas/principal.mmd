    VE --> E
    V -- Sí --> F{"opción"}
    F -- 1 --> G[["Agregar estudiante<br/>(total_estudiantes ← total_estudiantes + 1)"]]
    F -- 2 --> H[["Mostrar estudiantes"]]
    F -- 3 --> I[["Buscar estudiante por ID"]]
    F -- 4 --> J["bandera_salir ← Verdadero"]
    F -- Otro --> K[/"Mostrar: Opción no válida"/]
    G --> R
    H --> R
    I --> R
    J --> R
    K --> R
    R((1)) --> C
    C -- No --> L[/"Mostrar: Saliendo del sistema<br/>y total_estudiantes"/]
    L --> M([Fin])
